# ============================================================
# VARIABLES DE ENTORNO
# Copiar a .env.local para desarrollo, y configurar en el panel
# de Vercel para produccion. .env.local esta en .gitignore.
# ============================================================

# ------------------------------------------------------------
# DESTINO DEL FORMULARIO DE /contacto
#
# Hay dos caminos posibles y el formulario elige solo, segun cual
# de las dos variables este puesta. Si no hay ninguna, el
# formulario muestra un error con el email directo: nunca acepta
# un mensaje en silencio.
# ------------------------------------------------------------

# CAMINO 1 — WEB3FORMS (el que esta en uso)
#
# El mensaje llega a vuestro correo. Es el mas rapido de montar:
#   1. Entrar en https://web3forms.com
#   2. Escribir el email donde quereis recibir los mensajes
#   3. Confirmar el correo que os llega
#   4. Copiar aqui la Access Key
#
# Lleva NEXT_PUBLIC_ delante a proposito: Web3Forms exige que el
# envio salga del navegador, no del servidor (en su plan gratuito
# rechaza con 403 las peticiones de servidor). Las claves de
# Web3Forms estan pensadas para ser publicas; quien la tenga solo
# puede mandar mensajes al correo del dueno, no leer los ajenos.
NEXT_PUBLIC_WEB3FORMS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# CAMINO 2 — WEBHOOK PROPIO (Make, Zapier, n8n)
#
# Para cuando el mensaje tenga que hacer mas cosas ademas de
# llegar al correo: crear el contacto en el CRM, avisar por
# WhatsApp, etiquetar por sector.
#
# Si se pone esta, el formulario deja de usar Web3Forms y pasa por
# /api/contacto, que ademas valida en servidor y limita a 5 envios
# por IP cada 10 minutos. No hay que tocar codigo para cambiar.
#
# Como obtenerla en Make: escenario nuevo -> modulo "Webhooks" ->
# "Custom webhook" -> "Add" -> copiar la URL que genera.
# WEBHOOK_CONTACTO=https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# ANALITICA Y PIXELES
#
# Las dos son OPCIONALES. Si no se definen, no se carga nada
# aunque el visitante acepte todas las cookies. Asi se puede
# tener el banner en produccion antes de crear las cuentas, y un
# despliegue de preproduccion no ensucia las metricas.
#
# En los dos casos, la carga ocurre SOLO si el visitante ha
# aceptado la categoria correspondiente en el banner.
# ------------------------------------------------------------

# Google Analytics 4. El identificador de medicion, no el de la
# propiedad: Administrar -> Flujos de datos -> el flujo web.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel. El ID del pixel: Meta Events Manager -> Origenes de
# datos -> el pixel -> el numero que aparece bajo el nombre.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
