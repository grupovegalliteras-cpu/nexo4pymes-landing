# ============================================================
# VARIABLES DE ENTORNO
# Copiar a .env.local para desarrollo, y configurar en el panel
# de Vercel para produccion. .env.local esta en .gitignore.
# ============================================================

# Destino del formulario de /contacto.
#
# Es la URL de un webhook (Make, Zapier, n8n...). El escenario que
# cuelgue de ella decide que pasa con cada mensaje: enviarlo al
# email, crear el contacto en el CRM, avisar por WhatsApp, o todo.
#
# SIN esta variable, /api/contacto responde 503 y el formulario
# muestra el email directo como alternativa. Nunca acepta un
# mensaje en silencio.
#
# Como obtenerla en Make: escenario nuevo -> modulo "Webhooks" ->
# "Custom webhook" -> "Add" -> copiar la URL que genera.
WEBHOOK_CONTACTO=https://hook.eu2.make.com/xxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# ANALITICA Y PIXELES
#
# Las dos son OPCIONALES. Si no se definen, no se carga nada
# aunque el visitante acepte todas las cookies. Asi se puede
# tener el banner en produccion antes de crear las cuentas, y un
# despliegue de preproduccion no ensucia las metricas.
#
# En los dos casos, la carga ocurre SOLO si el visitante ha
# aceptado la categoria correspondiente en el banner.
# ------------------------------------------------------------

# Google Analytics 4. El identificador de medicion, no el de la
# propiedad: Administrar -> Flujos de datos -> el flujo web.
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Meta Pixel. El ID del pixel: Meta Events Manager -> Origenes de
# datos -> el pixel -> el numero que aparece bajo el nombre.
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456
